<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="AppTheme.Picker" parent="Theme.AppCompat.Light.NoActionBar" >
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:textColorHint">@color/white</item>
        <item name="materialAlertDialogTitleTextStyle">@style/App.Dialog.TitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/App.Dialog.BodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/App.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/App.Dialog.Button.Negative</item>

        <item name="colorSurface">#141342</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="App.Dialog.TitleText" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="App.Dialog.BodyText" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="App.Dialog.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="App.Dialog.Button.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/white</item>
    </style>

</resources>