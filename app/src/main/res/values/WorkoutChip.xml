<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WorkoutChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:background">@drawable/bg_chip_unselected</item>
        <item name="android:textColor">#AAAAAA</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="WorkoutChip.Selected">
        <item name="android:background">@drawable/bg_chip_selected</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>